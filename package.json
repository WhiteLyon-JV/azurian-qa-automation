{
  "name": "azurian-qa-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --format summary",
    "test:api": "cucumber-js --tags @api --format summary",
    "test:ui": "cucumber-js --tags @ui --format summary",
    "test:crear": "cucumber-js --tags @crear --format summary",
    "test:leer": "cucumber-js --tags @leer --format summary",
    "test:editar": "cucumber-js --tags @editar --format summary",
    "test:eliminar": "cucumber-js --tags @eliminar --format summary",
    "typecheck": "tsc --noEmit",
    "browsers:install": "playwright install chromium",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "results:prepare": "node scripts/prepare-results.cjs",
    "test:parallel": "cucumber-js --parallel 2 --format summary"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.13.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
